# 인증
AUTH_SECRET=<openssl rand -base64 32>

# 리버스 프록시나 터널 뒤에 둘 때 필요하다. 없으면 Auth.js가 내부 주소로
# 리다이렉트해서 로그인이 깨진다.
# AUTH_TRUST_HOST=true

# 데이터베이스
DATABASE_URL=postgres://study:study@127.0.0.1:7174/ai_study_board

# 협업 서버와 공유하는 비밀키. 협업 토큰 서명·검증에 쓴다.
COLLAB_TOKEN_SECRET=<openssl rand -base64 32>

# 포트 — 7171 블록
#   7171 웹 / 7172 협업 WebSocket / 7173 협업 버전 조회 / 7174 PostgreSQL
COLLAB_PORT=7172
COLLAB_VERSION_PORT=7173
NEXT_PUBLIC_COLLAB_PORT=7172

# 협업 서버가 브라우저에서 보기에 다른 주소일 때 설정한다.
# 비우면 브라우저가 접속한 호스트와 위 포트를 조합한다.
#
# 터널이나 리버스 프록시 뒤에서는 반드시 설정해야 한다. HTTPS 페이지에서
# ws://를 열면 혼합 콘텐츠로 차단되므로 wss:// 주소가 필요하다.
# 로컬 주소로 접속했을 때는 이 값을 무시하고 접속한 호스트를 쓴다.
#   예: NEXT_PUBLIC_COLLAB_URL=wss://collab.example.com
# NEXT_PUBLIC_COLLAB_URL=

# MCP 엔드포인트가 허용할 Origin. 쉼표로 구분한다.
# localhost와 127.0.0.1은 항상 허용된다. 브라우저에서 붙는 클라이언트가
# 있을 때만 설정하면 된다. Claude Code 같은 도구는 Origin을 보내지 않는다.
# MCP_ALLOWED_ORIGINS=study.example.com

# 실제 AI 모델을 붙일 때만 설정한다. 둘 다 없으면 목 어댑터로 동작한다.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
