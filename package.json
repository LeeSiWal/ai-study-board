{
  "name": "ai-study-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,collab -c cyan,magenta \"npm:dev:web\" \"npm:dev:collab\"",
    "dev:web": "next dev --port 7171 --hostname 0.0.0.0",
    "dev:collab": "tsx --env-file=.env.local collab-server/index.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "verify:collab": "tsx --env-file=.env.local scripts/verify-collab.ts",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx --env-file=.env.local scripts/check-endpoints.ts",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed-db.ts",
    "test:integration": "VITEST_SCOPE=integration tsx --env-file=.env.local node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@hocuspocus/provider": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tiptap/extension-collaboration": "^3.29.0",
    "@tiptap/extension-collaboration-caret": "^3.29.0",
    "@tiptap/extension-mathematics": "^3.29.0",
    "@tiptap/extension-table": "^3.29.0",
    "@tiptap/extension-task-item": "^3.29.0",
    "@tiptap/extension-task-list": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.4",
    "katex": "^0.17.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.49.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
